generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model KnowledgeEntry {
  id          Int      @id @default(autoincrement())
  section     String   // e.g., "History"
  title       String   // e.g., "Founded (August 2007)"
  contentType String   // "text", "list", "timeline"
  content     Json     // {text: "..."} or {items: [...]}
  keywords    String[]
  sources     String[]
}


